{
	"schemaVersion": 1,
	"id": "myriad",
	"version": "${version}",
	"name": "Myriad",
	"description": "An addon-first utility client with a tiling window manager UI. Ships with no modules of its own: everything plugs in through the Myriad API.",
	"authors": ["Myriad"],
	"license": "CC0-1.0",
	"contact": {
		"homepage": "https://github.com/MyriadClient/myriad-core",
		"sources": "https://github.com/MyriadClient/myriad-core",
		"issues": "https://github.com/MyriadClient/myriad-core/issues"
	},
	"icon": "assets/myriad/icon.png",
	"environment": "client",
	"accessWidener": "myriad.accesswidener",
	"entrypoints": {
		"client": ["dev.myriadclient.impl.MyriadClient"],
		"myriad": ["dev.myriadclient.impl.CoreAddon"],
		"modmenu": ["dev.myriadclient.impl.compat.ModMenuIntegration"]
	},
	"mixins": ["myriad.mixins.json"],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {
		"myriad-essentials": "<0.3.0",
		"myriad-boze": "<0.3.0",
		"myriad-omarchy": "<0.2.0"
	}
}
